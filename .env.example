# ==============================================================================
# NEERKAAVAL Emergency Broadcast Configuration
# ==============================================================================
# Copy this file to .env or set these in .streamlit/secrets.toml

# ── 1. Push Notifications (ntfy.sh) ───────────────────────────────────────────
# Works immediately without any signup or account!
# Open this URL in your browser or ntfy phone app to receive notifications:
# https://ntfy.sh/neerkaaval_alerts_demo
NTFY_TOPIC=neerkaaval_alerts_demo
NTFY_SERVER=https://ntfy.sh
# Optional: bearer token if using a private ntfy topic
NTFY_TOKEN=

# ── 2. Email (SMTP via Gmail) ────────────────────────────────────────────────
# For Gmail, you must generate a 16-character App Password (not your normal password):
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Name it "Neerkaaval" and copy the 16-character password generated.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_EMAIL=recipient_email@gmail.com

# ── 3. Telegram Bot ──────────────────────────────────────────────────────────
# 1. Create a bot using @BotFather on Telegram to get your bot token
# 2. Send a message to your bot, then get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
