# -------------------------------------------------------------------------------------------------
# NEERKAAVAL -- Environment Configuration Template
# -------------------------------------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Usage (local):
#   Copy-Item .env.example .env
#   # edit .env with your credentials
#   streamlit run app.py
#
# Usage (cloud / CI):
#   Set the variables below as environment secrets in your deployment platform.
# -------------------------------------------------------------------------------------------------

# -- Email (SMTP) ---------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=recipient@gmail.com

# -- ntfy.sh Push Notifications -------------------------------------------------------------------
# Subscribers open the ntfy app and subscribe to this topic to receive alerts.
NTFY_TOPIC=neerkaaval_alerts_demo
# NTFY_SERVER=https://ntfy.sh          # optional: self-hosted server
# NTFY_TOKEN=your_ntfy_bearer_token    # optional: private/access-controlled topics

# -- Telegram Bot ---------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
